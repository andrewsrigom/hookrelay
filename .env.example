# Local defaults; no cloud credentials are needed for pnpm dev.
API_PORT=4310
WEB_PORT=4317
RECEIVER_PORT=4311
# The default database and generated encryption key are stored in .local/.
# Set this to a separate directory to keep a test run isolated.
# HOOKRELAY_DATA_DIR=.local/my-run
# Cloud handlers read configuration from the CDK stack, never from this file.
